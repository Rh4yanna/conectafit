# Exemplo, sem credenciais reais. Site e API na mesma origem HTTPS.
NODE_ENV=production
FRONTEND_URL=https://conectafit.exemplo.com
FRONTEND_URLS=https://conectafit.exemplo.com
VITE_API_URL=/api
PORT=3000
BIND_HOST=127.0.0.1
# Somente se houver exatamente um proxy confiavel e a API nao for exposta diretamente.
TRUST_PROXY=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=conectafit
DB_USER=conectafit_runtime
DB_PASSWORD=SUBSTITUIR_NO_GERENCIADOR_DE_SEGREDOS
# Para banco remoto, true; nao desabilitar validacao de certificados.
DB_SSL=false
# Para Render: BIND_HOST=0.0.0.0 e DATABASE_URL do banco gerenciado com DB_SSL=true.
DATABASE_URL=
DB_SSL_CA=
DB_POOL_MAX=10
# Node 22. Credenciais apenas no servidor, preferencialmente arquivo secreto ADC.
IMAGE_STORAGE=database
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
GEOAPIFY_API_KEY=
# Google Cloud: habilitar Routes API e faturamento; restringir a chave a essa API
# e aos IPs de saida do servidor. Definir cotas no Google Cloud antes de ativar.
# Somente no servidor: nunca usar prefixo VITE_ para esta chave.
GOOGLE_ROUTES_API_KEY=
# Fornecer GMAIL_USER/GMAIL_APP_PASSWORD pelo gerenciador de segredos, se usar recuperacao por Gmail.
