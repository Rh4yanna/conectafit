# Desenvolvimento: copiar para .env; nunca versionar valores reais.
NODE_ENV=development
PORT=3000
BIND_HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5187
VITE_API_URL=/api
# Preferir DATABASE_URL OU os campos DB_*.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=conectafit
DB_USER=conectafit
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=
DB_POOL_MAX=10
TRUST_PROXY=false
# database mantém imagens no PostgreSQL; firebase ativa o bucket opcional.
IMAGE_STORAGE=database
FIREBASE_STORAGE_BUCKET=
# Escolher arquivo secreto ADC ou JSON somente no servidor (não VITE_*).
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GEOAPIFY_API_KEY=
GOOGLE_ROUTES_API_KEY=
# Sessões opacas ficam no PostgreSQL; não precisam de JWT_SECRET.
